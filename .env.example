# Browser_Workbench 环境变量示例（请勿在此文件中填写或提交真实凭据）
# 通过启动进程的环境传入；如使用 .env，需在启动时显式加载。仅创建文件不会自动生效。
# .env 已被 .gitignore 忽略。

# 本地工作台 HTTP / WebSocket 监听端口（默认 18767）
WORKBENCH_PORT=18767

# 本地工作台持久化数据目录（留空则使用默认 data 目录）
WORKBENCH_DATA_DIR=

# 本地工作台自动备份目录（留空则使用默认备份目录）
WORKBENCH_BACKUP_DIR=

# Facebook Graph 头像同步凭据（可选；桌面端优先存储于系统加密凭据库 safeStorage）
WORKBENCH_GRAPH_AVATAR_TOKEN=
