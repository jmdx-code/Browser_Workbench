# Browser_Workbench 环境变量示例（请勿在此文件中填写或提交真实凭据）
# 通过启动进程的环境传入；如使用 .env，需在启动时显式加载。仅创建文件不会自动生效。
# .env 已被 .gitignore 忽略。

# 本地工作台 HTTP / WebSocket 监听端口（正常使用请保持 18767）
WORKBENCH_PORT=18767

# 可选：不自定义目录时保持未设置，避免空值覆盖默认目录。
# WORKBENCH_DATA_DIR=C:/BrowserWorkbench/data

# 可选：自定义备份目录。
# WORKBENCH_BACKUP_DIR=C:/BrowserWorkbench/backups

# Facebook Graph 头像同步凭据（可选；桌面端优先存储于系统加密凭据库 safeStorage）
# WORKBENCH_GRAPH_AVATAR_TOKEN=
